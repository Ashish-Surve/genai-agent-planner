# ===== LLM CONFIGURATION =====

# Choose LLM provider: ollama, gemini, or claude
LLM_PROVIDER=ollama

# Ollama settings (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Gemini settings (if using Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# Claude settings (if using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===== DATABASE CONFIGURATION =====

DATABASE_PATH=data/database/adhd_planner.db

# ===== SYNC CONFIGURATION =====

# Enable/disable sync with Apple services
SYNC_ENABLED=true

# Sync interval in minutes
SYNC_INTERVAL_MINUTES=5

# Default sync settings for new tasks
DEFAULT_SYNC_TO_REMINDERS=true
DEFAULT_SYNC_TO_CALENDAR=true

# ===== LOGGING CONFIGURATION =====

LOG_LEVEL=INFO
LOG_FILE=data/logs/app.log

# ===== STREAMLIT CONFIGURATION =====

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_THEME_BASE=light

# ===== ADHD-SPECIFIC SETTINGS =====

# Maximum focus duration in minutes (before suggesting break)
MAX_FOCUS_DURATION=45

# Buffer time between tasks in minutes
BUFFER_TIME_BETWEEN_TASKS=10

# Context switch penalty in minutes
CONTEXT_SWITCH_PENALTY=5

# Typical work hours (24-hour format)
WORK_START_TIME=09:00
WORK_END_TIME=17:00

# Default break duration in minutes
DEFAULT_BREAK_DURATION=15

# ===== DEVELOPMENT SETTINGS =====

# Set to 'development' or 'production'
ENVIRONMENT=development

# Enable debug mode
DEBUG=false
